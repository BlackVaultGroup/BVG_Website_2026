# Browser-visible configuration only. Never place service-role, private, or admin keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Public Cal.com embed configuration. Use the event path, not an API key.
VITE_CAL_LINK=your-cal-username/strategy-call
VITE_CAL_EMBED_ENABLED=false
